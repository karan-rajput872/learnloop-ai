# ==============================================================================
# LearnLoop AI — Backend Environment Configuration Template
# ==============================================================================

# Server Port (Default: 8000)
PORT=8000

# Google Gemini API Key (Optional)
# If omitted, LearnLoop AI automatically activates its deterministic local pedagogical
# engine with rule-based misconception detection, Socratic scaffolds, and full functionality.
GEMINI_API_KEY=

# Gemini Model Identifier (Optional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated, e.g. https://learnloop-ai-one.vercel.app,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://learnloop-ai-one.vercel.app

# Environment Mode (development | production)
ENVIRONMENT=development

# JWT Authentication Signing Key (STRICTLY REQUIRED in Production: Must be a random 32+ char secret)
# When ENVIRONMENT=production or running on Render, the backend will fail startup if this is omitted.
JWT_SECRET_KEY=

# Access & Refresh Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Identity Services Client ID (Optional for Google OAuth)
GOOGLE_CLIENT_ID=

# Production Database Storage (Default: SQLite at data/learnloop.db)
# Option A: Render Persistent Disk (SQLite mounted path)
DATABASE_PATH=/var/data/learnloop.db
DATABASE_URL=sqlite:///./data/learnloop.db
# Option B: Managed Neon PostgreSQL (Activated automatically when DATABASE_URL starts with postgresql:// or postgres://)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Cookie Security Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ==============================================================================
# Private Owner Console & Analytics Configuration
# ==============================================================================
# Authorized Owner Email Address (Comma-separated if multiple administrators)
# Used to verify administrative privilege on every /api/owner/* request.
OWNER_EMAIL=karanrajput872@gmail.com

# Initial Owner Setup Password (Used exclusively for initial bootstrap if no owner exists)
OWNER_INITIAL_PASSWORD=OwnerPass123456!

# Analytics Data Retention Period in Days (Default: 90 days)
ANALYTICS_RETENTION_DAYS=90
