# ==============================================================================
# LearnLoop AI — Backend Environment Configuration Template
# ==============================================================================

# Server Port (Default: 8000)
PORT=8000

# Google Gemini API Key (Optional)
# If omitted, LearnLoop AI automatically activates its deterministic local pedagogical
# engine with rule-based misconception detection, Socratic scaffolds, and full functionality.
GEMINI_API_KEY=

# Gemini Model Identifier (Optional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated, e.g. https://learnloop-ai-one.vercel.app,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://learnloop-ai-one.vercel.app

# JWT Authentication Signing Key (Required in Production: Generate a 32+ char secret)
JWT_SECRET_KEY=learnloop-ai-production-jwt-secret-key-32chars-min-len-2026!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Identity Services Client ID (Optional for Google OAuth)
GOOGLE_CLIENT_ID=

# Production Database URL (Optional: defaults to persistent SQLite at data/learnloop.db)
DATABASE_URL=sqlite:///./data/learnloop.db

# Cookie Security Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=none
