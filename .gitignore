# ==============================================================================
# LearnLoop AI — Git Ignore Configuration
# ==============================================================================

# Environment & Secrets (NEVER commit live secrets)
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key
*.cert

# Python Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend Build & Compilation Artifacts
dist/
frontend/dist/
build/
.rollup.cache/
*.tsbuildinfo
node_modules/.tmp/
frontend/node_modules/.tmp/

# Local Database & Dynamic Runtime State
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/learner_store.json
backend/pre_state.json

# Temporary Files, Logs & Process Records
*.log
logs/
*.tmp
*.bak
*.swp
*~
scratch/

# IDE & Operating System Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Large Video & Audio Media Recordings (Retained Locally & Deliverable Reports)
*.mp4
*.webm
*.mp3
demo_assets/raw_video/
demo_assets/test_video/
demo_assets/final/raw_video/
demo_assets/final/*.mp4
demo_assets/final/*.webm
demo_assets/final/*.mp3
demo_assets/*.mp3

# Local Test Execution Artifacts
frontend/test_auth_ui_screenshots/
frontend/test_scroll_screenshots/
test_screenshots/

