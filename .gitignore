# ==============================================================================
# LearnLoop AI — Git Ignore Configuration
# ==============================================================================

# Environment & Secrets (NEVER commit live secrets)
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key
*.cert

# Python Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend Build & Compilation Artifacts
dist/
frontend/dist/
build/
.rollup.cache/
*.tsbuildinfo
node_modules/.tmp/
frontend/node_modules/.tmp/

# Local Database & Dynamic Runtime State
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/learner_store.json
backend/pre_state.json

# Temporary Files, Logs & Process Records
*.log
logs/
*.tmp
*.bak
*.swp
*~

# IDE & Operating System Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
